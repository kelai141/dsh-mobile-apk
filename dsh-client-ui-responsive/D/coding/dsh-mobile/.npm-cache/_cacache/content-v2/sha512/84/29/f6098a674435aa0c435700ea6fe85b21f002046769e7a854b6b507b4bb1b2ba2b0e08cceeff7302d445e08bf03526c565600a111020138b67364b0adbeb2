e":"git","directory":"vendor/timer"},"_npmVersion":"11.19.0","description":"Timer service for cordis","directories":{},"maintainers":[{"name":"imccyu","email":"imccyu@gmail.com"},{"name":"tianyicui-deepseek","email":"tianyi@deepseek.com"}],"_nodeVersion":"24.21.0","dependencies":{"@deepseek-ai/cosmokit":"~1.8.6"},"publishConfig":{"access":"public"},"_hasShrinkwrap":false,"peerDependencies":{"@deepseek-ai/cordis":"~4.0.5"},"_npmOperationalInternal":{"host":"s3://npm-registry-packages-npm-production","tmp":"tmp/cordis-plugin-timer_1.1.7_1792157964755_0.1896771025797701"}}},"time":{"created":"2026-08-10T19:02:08.984Z","modified":"2026-10-16T13:39:25.139Z","1.1.3-rc.1":"2026-08-10T19:02:09.425Z","1.1.3-rc.4":"2026-08-12T22:15:14.402Z","1.1.3":"2026-08-13T07:50:07.551Z","1.1.4":"2026-08-30T13:14:00.557Z","1.1.5":"2026-09-22T03:46:32.761Z","1.1.6":"2026-09-22T15:36:48.764Z","1.1.7-alpha.1":"2026-10-03T03:14:52.439Z","1.1.7-alpha.2":"2026-10-14T11:42:41.729Z","1.1.7":"2026-10-16T13:39:24.854Z"},"bugs":{"url":"https://github.com/deepseek-ai/deepseek-harness/issues"},"author":{"name":"Shigma","email":"shigma10826@gmail.com"},"license":"MIT","homepage":"https://github.com/deepseek-ai/deepseek-harness#readme","repository":{"url":"git+https://github.com/deepseek-ai/deepseek-harness.git","type":"git","directory":"vendor/timer"},"description":"Timer service for cordis","maintainers":[{"name":"imccyu","email":"imccyu@gmail.com"},{"name":"tianyicui-deepseek","email":"tianyi@deepseek.com"}],"readme":"# @cordisjs/plugin-timer\n\nDisposal-aware timer service for Cordis.\n\n## Usage\n\n```ts\nimport { Context } from 'cordis'\nimport Timer from '@cordisjs/plugin-timer'\n\nconst root = new Context()\nawait root.plugin(Timer)\n\nconst dispose = root.timeout(() => {\n  root.logger.info('done')\n}, 1000)\n\ndispose()\n```\n\nTimer handles are registered on the current fiber, so they are cleared\nautomatically when the plugin that created them is disposed.\n\n## API\n\n| API | Description |\n| --- | --- |\n| `ctx.timeout(callback, delay)` | Run once and return a disposer. |\n| `ctx.timeout(delay)` | Return a promise that resolves after `delay`. |\n| `ctx.interval(callback, delay)` | Run repeatedly and return a disposer. |\n| `ctx.interval(delay)` | Return an async iterator that yields on each interval. |\n| `ctx.throttle(callback, delay, noTrailing?)` | Return a throttled function with `.dispose()`. |\n| `ctx.debounce(callback, delay)` | Return a debounced function with `.dispose()`. |\n\n`ctx.setTimeout()` and `ctx.setInterval()` are kept as deprecated aliases for\n`ctx.timeout()` and `ctx.interval()`.\n","readmeFilename":"README.md"}