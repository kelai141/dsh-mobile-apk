+#[test]
+fn large_ordinary_symbol_table_matches_full_index() {
+    use crate::options::ParseOptions;
+    for tail in ["last", "last\0"] {
+        let mut bytes = "alpha\0\0βeta\0".repeat(88000).into_bytes();
+        bytes.extend(tail.bytes());
+        let indexed = Strtab::parse(&bytes, 0, bytes.len(), 0).unwrap();
+        let lazy = Strtab::parse_symbol_names(&bytes, 0, bytes.len(), &ParseOptions::default()).unwrap();
+        assert!(lazy.validated_nul_table);
+        assert_eq!(indexed.to_vec().unwrap(), lazy.to_vec().unwrap());
+        for offset in 0..bytes.len() + 2 {
+            assert_eq!(indexed.get_at(offset), lazy.get_at(offset));
+        }
+        bytes[999] = 0xff;
+        assert!(Strtab::parse_symbol_names(&bytes, 0, bytes.len(), &ParseOptions::default()).is_err());
+    }
+}
