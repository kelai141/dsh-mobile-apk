@@ -14,0 +15 @@
+export PATH=/system/bin
@@ -63,0 +65,3 @@
+
+distrib=${BIONILUX_NATIVE_LIB_DIR:?}/libbionilux-ldconfig.so
+[ -f "$distrib" ] && [ -x "$distrib" ] || die 'packaged ldconfig helper missing'
@@ -154 +158,2 @@
-lockdir="$rootfs/var/lock/bionilux-ldconfig.lock"
+lock_root="$rootfs/run/lock"
+lockdir="$lock_root/bionilux-ldconfig.lock"
@@ -173 +178,7 @@
-mkdir -p "$rootfs/var/lock" 2>/dev/null || die "cannot create $rootfs/var/lock"
+mkdir -p "$lock_root" 2>/dev/null || die "cannot create $lock_root"
+lock_root_real=$(resolve_path "$lock_root") || die "cannot resolve $lock_root"
+case $lock_root_real in
+    "$rootfs"/*) ;;
+    *) die "lock directory escapes the rootfs: $lock_root_real" ;;
+esac
+lockdir="$lock_root_real/bionilux-ldconfig.lock"
