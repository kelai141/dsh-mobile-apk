diff --git a/scripts/prepare-android-rootfs.sh b/scripts/prepare-android-rootfs.sh
--- a/scripts/prepare-android-rootfs.sh
+++ b/scripts/prepare-android-rootfs.sh
@@ -132,2 +132,4 @@
-if ! guest /usr/sbin/ldconfig.distrib --version >/dev/null 2>&1; then
-    die 'the diverted ldconfig does not run inside the guest'
+helper=${BIONILUX_NATIVE_LIB_DIR:?}/libbionilux-ldconfig.so
+[ -f "$helper" ] && [ -x "$helper" ] || die 'packaged ldconfig helper missing'
+if ! "$helper" --version >/dev/null 2>&1; then
+    die 'the packaged ldconfig helper does not run'
diff --git a/scripts/ldconfig-android.sh b/scripts/ldconfig-android.sh
--- a/scripts/ldconfig-android.sh
+++ b/scripts/ldconfig-android.sh
@@ -1 +1 @@
