{
  "name": "@deepseek-ai/dsh-ptc-runtime-node",
  "description": "Node PTC execution with async function, REPL and VM Script evaluators and optional retained state",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/ptc-runtime/ptc-runtime-node"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./configuration": {
      "types": "./lib/types/configuration.d.ts",
      "default": "./lib/configuration.js"
    },
    "./process": {
      "types": "./lib/types/process-entry.d.ts",
      "default": "./lib/process.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/configuration.js",
    "lib/process.js",
    "lib/persistent-process.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-timeout": "0.2.2-rc.1",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "birpc": "4.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-timeout": "0.2.2-rc.1",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.1",
    "@deepseek-ai/dsh-fs-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox-local": "0.2.2-rc.1"
  }
}