<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider 路径映射（issue #52 + 2026-08-23 安全审计 + 双层护栏扩展）：
     外部打开/分享需要 content://。运行时由 ChooserAllowlist + FileIncoming/PathOpen
     先执行硬黑名单（Android/data|obb|sandbox|obj、裸外部根、home/.dsh 除 workspaces 外全部、
     .ssh/.gnupg/.aws/.netrc 等凭据），再做允许根校验，并由 check-manifest-hardening.mjs
     审计全部 FileProvider URI 调用点：
     - 外部共享存储用户目录经 external_shared 与已有 dshdata_exports 映射（黑名单目录运行时硬拒绝）
     - 应用内用户目录映射 filesDir/home/、filesDir/home/.dsh/workspaces/、filesDir/home/tmp/、
       filesDir/usr/bin/、filesDir/usr/tmp/（.dsh 私密子区与 .ssh 等由运行时硬黑名单阻断）
     - cacheDir 仅窄映射 log-share/、attachments/、legacy-uploads/。 -->
<paths>
  <external-path name="dshdata_exports" path="Documents/dshdata/" />
  <external-path name="external_shared" path="." />
  <files-path name="internal_workspaces" path="home/.dsh/workspaces/" />
  <files-path name="internal_tmp" path="home/tmp/" />
  <files-path name="internal_home" path="home/" />
  <files-path name="internal_usr_bin" path="usr/bin/" />
  <files-path name="internal_usr_tmp" path="usr/tmp/" />
  <!-- 0.14.6 功能 B：启动页「分享诊断包」的 ZIP 只落在 cacheDir/log-share/。 -->
  <cache-path name="log_share" path="log-share/" />
  <!-- 原生拍照成品与原图（cacheDir/attachments/）。 -->
  <cache-path name="photo_attachments" path="attachments/" />
  <!-- 旧系统附件选择器只映射用户明确选中的附件暂存副本。 -->
  <cache-path name="legacy_uploads" path="legacy-uploads/" />
</paths>
